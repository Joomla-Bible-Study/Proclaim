{
  "name": "com_proclaim",
  "version": "10.7.8",
  "description": "CWM Proclaim - A Joomla! Extension for Church Media Management",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joomla-Bible-Study/Proclaim.git"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-terser": "^1.0.2",
    "csso": "^5.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "intl-tel-input": "^29.5.11",
    "jsdom": "^31.0.1",
    "rollup": "^4.68.7",
    "rollup-plugin-gzip": "^4.2.1",
    "sortablejs": "^1.15.7",
    "terser": "^5.51.4"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:assets",
    "build:js": "SOURCE_DIR=build/media_source/js OUTPUT_DIR=media/js rollup -c libraries/vendor/cwm/build-tools/templates/rollup.config.js",
    "build:css": "SOURCE_DIR=build/media_source/css OUTPUT_DIR=media/css node libraries/vendor/cwm/build-tools/templates/build-css.js",
    "build:assets": "node libraries/vendor/cwm/build-tools/templates/build-assets.js",
    "watch": "SOURCE_DIR=build/media_source/js OUTPUT_DIR=media/js rollup -c libraries/vendor/cwm/build-tools/templates/rollup.config.js -w",
    "test": "node --test --test-timeout=10000 \"tests/js/**/*.test.js\" \"tests/js/**/*.spec.js\"",
    "test:watch": "node --test --watch --test-timeout=10000 \"tests/js/**/*.test.js\" \"tests/js/**/*.spec.js\"",
    "test:coverage": "mkdir -p build/reports/coverage-js && node --test --test-timeout=10000 --experimental-test-coverage --test-coverage-include=\"build/media_source/js/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=build/reports/coverage-js/lcov.info \"tests/js/**/*.test.js\" \"tests/js/**/*.spec.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report build/reports/e2e",
    "lint:js": "eslint --no-config-lookup -c eslint.config.mjs --max-warnings=0 ."
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.15",
    "chart.js": "^4.6.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "brace-expansion": "^5.0.6",
    "ws": "^8.21.0",
    "minimatch": "^11.0.8"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true
  }
}
