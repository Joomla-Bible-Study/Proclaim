<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="webservices" method="upgrade">
    <name>plg_webservices_proclaim</name>
    <author>CWM Team</author>
    <creationDate>2026-07-26</creationDate>
    <copyright>(C) 2026 CWM Team All rights reserved</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>support@christianwebministries.org</authorEmail>
    <authorUrl>https://www.christianwebministries.org</authorUrl>
    <version>10.3.6</version>
    <description>PLG_WEBSERVICES_PROCLAIM_DESCRIPTION</description>
    <namespace path="src">CWM\Plugin\WebServices\Proclaim</namespace>
    <files>
        <folder plugin="proclaim">services</folder>
        <folder>src</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <!--
                    Whether GET requests may be made without a token.

                    There is deliberately no separate on/off setting: disabling
                    this plugin turns the API off, which is where a Joomla
                    administrator looks first and needs no Proclaim-specific
                    knowledge.

                    Writes always require a token regardless of this setting, and
                    every read is filtered to the caller's authorised view levels,
                    so "public" never means "unfiltered".
                -->
                <field
                    name="public_reads"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    label="PLG_WEBSERVICES_PROCLAIM_PUBLIC_READS_LABEL"
                    description="PLG_WEBSERVICES_PROCLAIM_PUBLIC_READS_DESC"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <languages>
        <language tag="en-GB">language/en-GB/plg_webservices_proclaim.ini</language>
        <language tag="en-GB">language/en-GB/plg_webservices_proclaim.sys.ini</language>
    </languages>
</extension>
