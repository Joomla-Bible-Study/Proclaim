<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="CWM\Component\Proclaim\Administrator\Field">
    <field name="published"
           type="status"
           label="JSTATUS"
           description="JFIELD_PUBLISHED_DESC"
           default="1"
           filter="int"/>

    <field name="title" type="text" label="JGLOBAL_TITLE"
           description="JBS_PLAYLIST_TITLE_DESC"
           size="75" required="true" filter="trim"/>

    <field name="alias" type="text" label="JFIELD_ALIAS_LABEL"
           description="JFIELD_ALIAS_DESC"
           hint="JFIELD_ALIAS_PLACEHOLDER" size="75" filter="trim"/>

    <field name="description" type="textarea" label="JGLOBAL_DESCRIPTION"
           description="JBS_PLAYLIST_DESCRIPTION_DESC"
           cols="60" rows="5" filter="safehtml"/>

    <field name="server_id" type="ServerList" capability="playlists"
           label="JBS_PLAYLIST_SERVER" description="JBS_PLAYLIST_SERVER_DESC"
           required="true" validate="options">
        <option value="">JBS_CMN_SELECT_SERVER</option>
    </field>

    <field name="remote_playlist_id" type="PlaylistPicker"
           label="JBS_PLAYLIST_YOUTUBE_ID" description="JBS_PLAYLIST_YOUTUBE_ID_DESC"
           size="50" filter="trim"
           hint="PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>

    <field name="series_id" type="Series"
           label="JBS_PLAYLIST_SERIES" description="JBS_PLAYLIST_SERIES_DESC"
           validate="options">
        <option value="">JBS_PLAYLIST_NO_SERIES</option>
    </field>

    <field name="sync_enabled" type="radio" label="JBS_PLAYLIST_SYNC_ENABLED"
           description="JBS_PLAYLIST_SYNC_ENABLED_DESC"
           layout="joomla.form.field.radio.switcher" default="0" filter="int">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>

    <field name="writeback_enabled" type="radio" label="JBS_PLAYLIST_WRITEBACK_ENABLED"
           description="JBS_PLAYLIST_WRITEBACK_ENABLED_DESC"
           layout="joomla.form.field.radio.switcher" default="0" filter="int"
           showon="sync_enabled:1">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>

    <field name="last_sync" type="calendar" label="JBS_PLAYLIST_LAST_SYNC"
           description="JBS_PLAYLIST_LAST_SYNC_DESC"
           translateformat="true" showtime="true" readonly="true" filter="user_utc"/>

    <fields name="default_settings">
        <fieldset name="default_settings"
                  label="JBS_PLAYLIST_DEFAULTS_FIELDSET"
                  description="JBS_PLAYLIST_DEFAULTS_FIELDSET_DESC">
            <field name="default_published" type="list"
                   label="JBS_PLAYLIST_DEFAULT_PUBLISHED" description="JBS_PLAYLIST_DEFAULT_PUBLISHED_DESC"
                   default="1">
                <option value="1">JPUBLISHED</option>
                <option value="0">JUNPUBLISHED</option>
            </field>
            <field name="default_teacher_id" type="TeacherList" searchable="true"
                   label="JBS_PLAYLIST_DEFAULT_TEACHER" description="JBS_PLAYLIST_DEFAULT_TEACHER_DESC">
                <option value="">JBS_CMN_SELECT_TEACHER</option>
            </field>
            <field name="default_description" type="textarea"
                   label="JBS_PLAYLIST_DEFAULT_DESCRIPTION" description="JBS_PLAYLIST_DEFAULT_DESCRIPTION_DESC"
                   cols="60" rows="4" filter="safehtml"/>
        </fieldset>
    </fields>

    <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
           description="JBS_CMN_SELECT_LANGUAGE_DESC">
        <option value="*">JALL</option>
    </field>

    <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
           description="JFIELD_ACCESS_DESC"/>

    <field name="ordering" type="hidden" filter="int"/>
    <field name="asset_id" type="hidden" filter="unset"/>

    <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL"
           translate_label="false" filter="rules" component="com_proclaim"
           section="playlist" validate="rules"/>

    <field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL"
           description="JGLOBAL_FIELD_ID_DESC" size="10" default="0" readonly="true"/>

    <field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL"
           translateformat="true" showtime="true" filter="user_utc"/>
    <field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" validate="UserId"/>
    <field name="created_by_alias" type="text" label="JGLOBAL_FIELD_CREATED_BY_ALIAS_LABEL"/>
    <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL"
           class="form-control" translateformat="true" showtime="true" readonly="true" filter="user_utc"/>
    <field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
           class="readonly" readonly="true" filter="unset" validate="UserId"/>
</form>
